---
import Base from "../layouts/Base.astro";
import Header from "../components/Header.astro";
import MenuOverlay from "../components/MenuOverlay.astro";
import Footer from "../components/Footer.astro";
import Reveal from "../components/Reveal.astro";
import Figure from "../components/Figure.astro";
import Carousel from "../components/Carousel.astro";
import officeAbout1 from "../assets/office-about-1.jpeg";
import officeAbout2 from "../assets/office-about-2.jpeg";
import officeAbout3 from "../assets/office-about-3.jpeg";
import officeAbout4 from "../assets/office-about-4.jpeg";
import officeAbout5 from "../assets/office-about-5.jpeg";
import officeAbout6 from "../assets/office-about-6.jpeg";
import officeAbout7 from "../assets/office-about-7.jpeg";
import officeAbout8 from "../assets/office-about-8.jpeg";
import athens1 from "../assets/athens-1.jpeg";
import athens2 from "../assets/athens-2.jpeg";
import athens3 from "../assets/athens-3.jpeg";
import athens4 from "../assets/athens-4.jpeg";
import desk1 from "../assets/desk-1.jpeg";

// All 8 are ~3:2 landscape in a square frame: the crop shows the middle 2/3 of
// the width, and `position` (x%) slides that window left (0%) → right (100%).
const officeSlides = [
  { img: officeAbout1, alt: "Over-the-shoulder view of a silhouetted designer looking at Greek typesetting on a large monitor", position: "100% 50%" }, // keep the head at right
  { img: officeAbout2, alt: "Studio corner with a black drawer unit, a large monstera, a framed art poster and an orange wire lounge chair with bags hanging on it", position: "85% 50%" }, // keep chair + bag
  { img: officeAbout3, alt: "Two monitors back to back on a shared desk in front of a sunlit roller blind" },
  { img: officeAbout4, alt: "A monstera beside stacked cardboard boxes and an orange wire chair, shot at a tilted angle" },
  { img: officeAbout5, alt: "Dark studio interior on film, with a bright window and a green light leak along one edge" },
  { img: officeAbout6, alt: "Double-exposed film photo of the studio: monstera leaves, a window blind and large lettering on the wall" },
  { img: officeAbout7, alt: "Hands holding open a magazine spread about a corporate identity project, with monstera leaves behind" },
  { img: officeAbout8, alt: "An open magazine spread about a corporate identity project, held up in front of a ribbed wall" },
];
const athensSlides = [
  { img: athens1, alt: "Untitled Office — a figure in a patterned orange shirt seen through ribbed glass" },
  { img: athens2, alt: "An outstretched arm holding up a paper rubbing of a manhole cover above a tiled pavement" },
  { img: athens3, alt: "A corner of the studio: a Carrera 1969 poster above a narrow desk, a wooden stool and a plant on a side table" },
  { img: athens4, alt: "Black-and-white arcade with a marble column, a circular mosaic floor and a motion-blurred passer-by in front of a poster" },
];
---
<Base title="About — Untitled Office">
  <MenuOverlay />
  <Header />
  <main>
    <section class="ab-intro edge">
      <Reveal as="p" class="ab-eyebrow mono">About Us</Reveal>

      <Reveal as="h1" class="ab-heading">
        <span class="ab-light">Founded in Athens in 2020, Untitled Office is an award-winning design studio
        specializing in branding, visual identity, and print design.</span><br />
        <span class="ab-light">We don’t follow templates. We don’t seek titles.<br />
        Every project is a conversation — quiet, intentional, and open.</span>
      </Reveal>

      <div class="ab-body">
        <Reveal as="p" class="lede">
          We begin with questions, not assumptions. We design with structure, clarity, and care. Our process is collaborative,
          our language is visual, and our work reflects a deep respect for craft, concept, and materiality.
        </Reveal>
        <Reveal as="p" class="lede">
          Based at Ippokratous 7 in the center of Athens, we work with clients locally and internationally — always from scratch.
          No slogans. No noise. Just thoughtful design that leaves space for meaning.
        </Reveal>
      </div>
    </section>

    <!-- Full-bleed inverted band behind the image row; the images start above it
         and the wide shot spills out of its bottom edge (same device as Philosophy). -->
    <section class="ab-gallery">
      <div class="ab-band">
        <div class="ab-panel" data-invert aria-hidden="true"></div>
        <div class="ab-images edge" data-invert>
          <Carousel slides={athensSlides} leftLabel="athens" ext=".jpeg" ratio="7 / 10" />
          <Carousel slides={officeSlides} leftLabel="office" ext=".jpeg" ratio="1 / 1" />
        </div>
      </div>
      <div class="ab-wide">
        <Figure ratio="5 / 3" caption={false} image={desk1} alt="Hands at a white keyboard and mouse on a studio desk, below a monitor showing a page of smiley-face illustrations and Greek text" />
      </div>
    </section>

    <section class="ab-office edge">
      <h2 class="ab-office-h" aria-label="Our Office">
        <span class="ab-word" aria-hidden="true"><span class="ab-s">O</span><span class="ab-p">u</span><span class="ab-s">r</span></span>
        <span class="ab-word" aria-hidden="true"><span class="ab-s">Offic</span><span class="ab-p">e</span></span>
      </h2>
    </section>
  </main>
  <Footer />
</Base>

<style>
  .ab-intro {
    padding-top: clamp(1rem, 3vw, 3rem);
  }
  /* comp sets this eyebrow in title case, unlike the uppercase captions */
  .ab-eyebrow {
    text-transform: none;
    margin: 0 0 clamp(1.2rem, 2.5vw, 2rem);
  }
  .ab-heading {
    font-family: var(--ff-display);
    font-weight: 700;
    font-size: clamp(1.5rem, 3.3vw, 4rem);
    line-height: 1.3;
    letter-spacing: -0.02em;
    margin: 0;
    /* wraps naturally within the content width; the <br>s still start each
       sentence group on its own line */
  }
  .ab-light { font-weight: 500; } /* display cut ships 500/700 only */
  .ab-body { margin-top: clamp(1.2rem, 2.5vw, 2rem); color: var(--muted); }
  /* same body scale as the homepage About/Philosophy copy */
  .lede {
    font-size: clamp(1rem, 1.74vw, 33px);
    line-height: 1.4;
    margin: 0 0 1.2em;
  }
  .ab-body > :global(:last-child) { margin-bottom: 0; }
  /* fixed gap between the two body paragraphs */
  .ab-body > :global(:first-child) { margin-bottom: 35px; }

  /* ---------- image band ---------- */
  .ab-gallery {
    --spill: clamp(2.5rem, 7.5vw, 8rem); /* how far the panel runs past the captions */
    margin-top: clamp(2.5rem, 6vw, 5rem);
  }
  .ab-band { position: relative; }
  .ab-panel {
    position: absolute;
    inset-inline: 0;
    top: 26%;
    bottom: calc(-1 * var(--spill));
    background: var(--panel);
    border-radius: clamp(18px, 1.8vw, 30px) clamp(18px, 1.8vw, 30px) 0 0;
    z-index: 0;
  }
  .ab-images {
    position: relative;
    z-index: 1;
    display: grid;
    /* 7/10 portrait + square at equal heights (32.2% = 46% × 0.7); trailing 1fr
       left empty so the panel shows to the right, as in the comp */
    grid-template-columns: 32.2% 46% 1fr;
    gap: clamp(1rem, 2.5vw, 2.2rem);
    align-items: start;
    color: var(--on-panel);
  }
  /* captions sit on the inverted panel → recolor to --on-panel */
  .ab-images :global(.controls),
  .ab-images :global(.counter),
  .ab-images :global(.cap-label) { color: var(--on-panel); }
  /* borderless, like the carousel photos above */
  .ab-wide :global(.ph) { border: 0; }

  /* wide shot: offset right like the comp, overlapping the panel's bottom edge */
  .ab-wide {
    position: relative;
    z-index: 1;
    width: 80.6%;
    margin-left: 13.8%;
    /* the panel's spill is absolutely positioned (takes no flow space), so a
       positive offset leaves a gap below the captions and overlaps the
       remaining 0.7 × spill of black panel */
    margin-top: calc(var(--spill) * 0.3);
  }

  /* ---------- "Our Office" ---------- */
  .ab-office {
    position: relative;
    z-index: 2; /* the heading overlaps the wide shot's bottom edge */
    padding-bottom: clamp(1.5rem, 4vw, 3rem);
  }
  .ab-office-h {
    font-size: clamp(4rem, 18vw, 16rem); /* same scale as the 5—years banner */
    line-height: 1;
    font-weight: 400;
    margin: -0.2em 0 0;
    display: flex;
    flex-wrap: wrap;
    column-gap: 0.12em;
    white-space: nowrap;
  }
  .ab-word {
    position: relative;
    padding-bottom: 0.06em;
  }
  /* thin static rule under each word */
  .ab-word::after {
    content: "";
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    height: max(1px, 0.012em);
    background: currentColor;
  }
  .ab-s { font-family: var(--ff-display); font-weight: 500; letter-spacing: -0.02em; }
  .ab-p { font-family: var(--ff-pixelscript); font-weight: 400; }

  @media (max-width: 820px) {
    .ab-heading,
    .lede { white-space: normal; }
    .ab-heading br,
    .lede br { display: none; }
    .ab-heading { font-size: clamp(1.4rem, 5.4vw, 2rem); line-height: 1.2; }
    .lede { font-size: clamp(1rem, 3.4vw, 1.25rem); }
  }
  @media (max-width: 720px) {
    .ab-images { grid-template-columns: 1fr; }
    .ab-panel { top: 18%; }
    .ab-wide { width: auto; margin-inline: var(--edge); }
    .ab-office-h { font-size: clamp(3.2rem, 20vw, 6rem); }
  }
</style>
