---
import Base from "../layouts/Base.astro";
import Header from "../components/Header.astro";
import MenuOverlay from "../components/MenuOverlay.astro";
import Footer from "../components/Footer.astro";
import Reveal from "../components/Reveal.astro";
import YearsBanner from "../components/YearsBanner.astro";

// Netlify Forms: the static <form> below is detected at deploy time (name +
// data-netlify). The honeypot field catches bots; JS posts the form in place
// and swaps in the thank-you message (native POST → ?sent=1 as the fallback).
const MAPS_URL = "https://www.google.com/maps/search/?api=1&query=Ippokratous+7,+106+79+Athens";
---
<Base title="Contact — Untitled Office">
  <MenuOverlay />
  <Header />
  <main>
    <section class="ct-top edge">
      <Reveal as="p" class="ct-block">
        <a class="ct-line u-link" href="tel:+302114061673"><span class="ct-l1">Get in touch</span><span class="ct-l2">(+30) 211 406 1673</span></a>
      </Reveal>
      <Reveal as="p" class="ct-block">
        <a class="ct-line u-link" href={MAPS_URL} target="_blank" rel="noopener noreferrer"><span class="ct-l1">Ippokratous 7</span><span class="ct-l2">106—79 Ath (Gr)</span></a>
      </Reveal>
    </section>

    <section class="ct-form-wrap edge">
      <form class="ct-form" name="contact" method="POST" action="/contact?sent=1" data-netlify="true" netlify-honeypot="bot-field" data-contact-form>
        <input type="hidden" name="form-name" value="contact" />
        <p class="hp" aria-hidden="true"><label>Leave this field empty <input name="bot-field" tabindex="-1" autocomplete="off" /></label></p>

        <div class="fields">
          <label class="field">
            <span class="f-label">Name/Surname*</span>
            <input type="text" name="name" required autocomplete="name" />
          </label>
          <label class="field">
            <span class="f-label">Telephone*</span>
            <input type="tel" name="telephone" required autocomplete="tel" />
          </label>
          <label class="field">
            <span class="f-label">E-mail*</span>
            <input type="email" name="email" required autocomplete="email" />
          </label>
          <label class="field">
            <span class="f-label">Industry-website*</span>
            <input type="url" name="website" required autocomplete="url" placeholder="https://" />
          </label>
          <label class="field field--area">
            <span class="f-label">Description*</span>
            <textarea name="description" rows="4" required></textarea>
          </label>
        </div>

        <button class="send-pill" type="submit">Send</button>
      </form>

      <p class="form-ok" data-form-ok hidden role="status">Thank you — your message has been sent. We’ll be in touch.</p>
    </section>

    <!-- MapLibre + OpenFreeMap (no key/cookies), loaded when near the viewport.
         The fallback sits underneath: covered once the map renders, and left
         in place if it fails (or JS is off). -->
    <section class="ct-map edge">
      <div class="map-frame" data-map-frame>
        <div class="map-fallback" data-map-fallback>
          <p class="map-addr">Ippokratous 7<br />106 79 Athens (Gr)</p>
          <a class="u-link mono" href={MAPS_URL} target="_blank" rel="noopener noreferrer">Open in Google Maps</a>
        </div>
        <div class="map-live" data-map-live></div>
      </div>
    </section>

    <YearsBanner />
  </main>
  <Footer />
</Base>

<style>
  /* ---------- top link blocks (footer CTA typography, static underline) ---------- */
  .ct-top {
    display: flex;
    flex-wrap: wrap;
    gap: clamp(1.5rem, 4vw, 4rem);
    padding-top: clamp(1rem, 3vw, 3rem);
  }
  .ct-block { margin: 0; }
  .ct-line {
    display: block;
    font-family: var(--ff-display);
    font-weight: 500; /* display cut ships 500/700 only */
    font-size: clamp(1.6rem, 2.8vw, 2.6rem);
    line-height: 1.02;
    letter-spacing: -0.02em;
    transition: color 280ms ease;
  }
  .ct-line:hover,
  .ct-line:focus-visible { color: var(--muted); }
  .ct-l1, .ct-l2 { display: block; width: fit-content; }

  /* ---------- form ---------- */
  .ct-form-wrap { margin-top: clamp(2.5rem, 6vw, 5rem); }
  .ct-form {
    display: grid;
    /* fields ≈ 64% of the content width (comp); Send sits below, left-aligned */
    grid-template-columns: 64%;
    row-gap: clamp(1.5rem, 3vw, 2.5rem);
    justify-items: start;
  }
  .fields { width: 100%; }
  .hp { position: absolute; left: -9999px; width: 1px; height: 1px; overflow: hidden; }
  .fields { display: grid; gap: clamp(1rem, 2vw, 1.6rem); }
  .field { display: grid; gap: 0.35rem; }
  .f-label { font-size: 0.85rem; }
  .field input,
  .field textarea {
    width: 100%;
    background: transparent;
    color: var(--fg);
    border: 0;
    border-bottom: 1px solid var(--hairline);
    border-radius: 0;
    padding: 0.35rem 0;
    font: inherit;
    font-size: 1rem;
    outline: none;
    transition: border-color 200ms ease;
  }
  .field textarea { resize: vertical; min-height: 5.5rem; }
  .field input:focus-visible,
  .field textarea:focus-visible { border-bottom-color: var(--fg); }
  .field input::placeholder { color: var(--muted); }

  /* outlined pill (≈190×48px on desktop, rem so it scales with the site);
     fills with ink on hover */
  .send-pill {
    display: inline-grid;
    place-items: center;
    width: 11.875rem;
    height: 3rem;
    padding: 0 1.5rem;
    background: transparent;
    color: var(--fg);
    border: 1px solid var(--fg);
    border-radius: 999px;
    font-family: var(--ff-display);
    font-weight: 500; /* display cut ships 500/700 only */
    font-size: clamp(1.15rem, 1.5vw, 1.5rem);
    letter-spacing: -0.02em;
    line-height: 1;
    cursor: pointer;
    transition: background-color 200ms ease, color 200ms ease;
  }
  .send-pill:hover { background: var(--fg); color: var(--bg); }
  .send-pill:focus-visible { outline: 2px solid var(--fg); outline-offset: 3px; }
  .send-pill:disabled { opacity: 0.5; cursor: default; }
  .form-ok {
    font-size: clamp(1rem, 1.74vw, 33px);
    line-height: 1.4;
    margin: 0;
  }

  /* ---------- map ---------- */
  .ct-map { margin-top: clamp(2.5rem, 6vw, 5rem); }
  .map-frame {
    position: relative;
    width: 100%;
    aspect-ratio: 2.06 / 1;
    /* theme-tinted surface: grey in grayscale, orange-tinted in orange */
    background: color-mix(in srgb, var(--fg) 10%, var(--bg));
    /* always-rounded, same radius as the photo hover; clips canvas, controls,
       attribution and fallback. isolate → the clip also holds over the
       GPU-composited WebGL canvas (WebKit) */
    border-radius: clamp(18px, 1.8vw, 30px);
    display: grid;
    place-items: center;
    overflow: hidden;
    isolation: isolate;
  }
  /* fallback: the address + link, under the map (visible until it renders,
     and permanently if it fails or JS is off) */
  .map-fallback { display: grid; justify-items: center; gap: 0.8rem; text-align: center; padding: 1rem; }
  .map-addr { margin: 0; font-size: clamp(1rem, 1.74vw, 33px); line-height: 1.3; }
  .map-live { position: absolute; inset: 0; z-index: 1; }

  /* MapLibre builds these nodes at runtime, so they need :global */
  /* pin: ink teardrop, anchored at its tip (MapLibre owns the outer transform) */
  .map-live :global(.map-pin) { display: block; width: 1.4rem; height: 1.9rem; }
  .map-live :global(.map-pin-head) {
    position: absolute;
    left: 50%; top: 0;
    width: 1.4rem; height: 1.4rem;
    background: var(--fg);
    border-radius: 50% 50% 50% 0;
    transform: translateX(-50%) rotate(-45deg);
  }
  .map-live :global(.map-pin-head)::after {
    content: "";
    position: absolute;
    inset: 32%;
    border-radius: 50%;
    background: var(--bg);
  }
  /* zoom buttons: flat, themed surface; icons are black SVGs → invert in dark */
  .map-live :global(.maplibregl-ctrl-group) {
    background: var(--bg);
    border: 1px solid var(--hairline);
    border-radius: 0;
    box-shadow: none;
  }
  .map-live :global(.maplibregl-ctrl-group button + button) { border-top: 1px solid var(--hairline); }
  :global([data-mode="dark"]) .map-live :global(.maplibregl-ctrl-icon) { filter: invert(1); }
  /* attribution: small + quiet, but legible */
  .map-live :global(.maplibregl-ctrl-attrib) {
    font-family: var(--ff-sans);
    font-size: 10px;
    background: color-mix(in srgb, var(--bg) 75%, transparent);
    color: var(--muted);
    /* nudge in from the bottom-right corner so the rounding doesn't clip the
       required credit text */
    margin: 0 0.9rem 0.35rem 0;
  }
  .map-live :global(.maplibregl-ctrl-attrib a) { color: inherit; }
  /* custom cursor: over the map frame, hide the dot and show native cursors
     (dragging needs grab feedback). The global `html.has-custom-cursor *
     { cursor: none }` hits every descendant directly (canvas, icons, links),
     so within the frame: reset to auto, make descendants inherit, then
     re-assert MapLibre's grab / grabbing and pointer on controls + links —
     all out-specifying the global (0,1,1) rule, scoped to .map-frame only. */
  :global(html.has-custom-cursor:has(.map-frame:hover) #uo-cursor) { opacity: 0 !important; }
  :global(html.has-custom-cursor) .map-frame { cursor: auto; }
  :global(html.has-custom-cursor) .map-frame :global(*) { cursor: inherit; }
  :global(html.has-custom-cursor) .map-frame :global(.maplibregl-interactive) { cursor: grab; }
  :global(html.has-custom-cursor) .map-frame :global(.maplibregl-interactive:active) { cursor: grabbing; }
  :global(html.has-custom-cursor) .map-frame :global(:is(a, button:not(:disabled))) { cursor: pointer; }

  @media (max-width: 820px) {
    .ct-form { grid-template-columns: 1fr; }
    .ct-line { font-size: clamp(1.4rem, 5vw, 1.8rem); }
    .map-frame { aspect-ratio: 4 / 3; }
  }
</style>

<script>
  // Post in place (Netlify Forms accepts a urlencoded POST to any path) and show
  // the thank-you; on any failure fall back to the native submit (→ ?sent=1).
  const form = document.querySelector("[data-contact-form]");
  const ok = document.querySelector("[data-form-ok]");
  function showOk() {
    if (form instanceof HTMLElement) form.hidden = true;
    if (ok instanceof HTMLElement) ok.hidden = false;
  }
  if (new URLSearchParams(location.search).get("sent") === "1") showOk();

  if (form instanceof HTMLFormElement) {
    form.addEventListener("submit", async (e) => {
      e.preventDefault();
      if (!form.reportValidity()) return;
      const btn = form.querySelector("button[type=submit]");
      if (btn instanceof HTMLButtonElement) btn.disabled = true;
      try {
        const res = await fetch("/", {
          method: "POST",
          headers: { "Content-Type": "application/x-www-form-urlencoded" },
          body: new URLSearchParams(new FormData(form) as any).toString(),
        });
        if (!res.ok) throw new Error(String(res.status));
        showOk();
      } catch (err) {
        if (btn instanceof HTMLButtonElement) btn.disabled = false;
        form.submit();
      }
    });
  }

  // Map: fetch MapLibre (+ its CSS and worker) only when the frame is within
  // ~400px of the viewport. On success the fallback is hidden from assistive
  // tech (the map covers it visually); on failure the live layer is cleared
  // and the themed address fallback simply stays.
  const mapLive = document.querySelector("[data-map-live]");
  const mapFallback = document.querySelector("[data-map-fallback]");
  if (mapLive instanceof HTMLElement && "IntersectionObserver" in window) {
    const io = new IntersectionObserver(async (entries) => {
      if (!entries.some((e) => e.isIntersecting)) return;
      io.disconnect();
      try {
        const { createContactMap } = await import("../scripts/contact-map");
        await createContactMap(mapLive, "Map showing Untitled Office at Ippokratous 7, Athens");
        mapFallback?.setAttribute("aria-hidden", "true");
      } catch (err) {
        mapLive.replaceChildren();
        mapLive.hidden = true;
      }
    }, { rootMargin: "400px 0px" });
    io.observe(mapLive);
  }
</script>
