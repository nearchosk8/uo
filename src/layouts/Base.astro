---
import "../styles/global.css";
import CustomCursor from "../components/CustomCursor.astro";
import { CONSENT_COOKIE, CONSENT_REVISION } from "../scripts/consent-config";
const GTM_ID = "GTM-TFFPDRTG";
const { title = "Untitled Office — Design Office, Athens", description = "Untitled Office is a design office based in Athens, Greece, known for a systematic approach to design-driven projects across Brand, Print, Screen and Space." } = Astro.props;
---

<!doctype html>
<html lang="en" data-mode="light" data-color="grayscale">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <!-- Google Consent Mode v2 (advanced): defaults first, before GTM. GTM
         always loads; the consent state decides what its tags may store.
         A choice stored by the cookie banner (current revision only) is
         re-applied right away, so returning visitors don't start as denied. -->
    <script is:inline define:vars={{ consentCookie: CONSENT_COOKIE, consentRevision: CONSENT_REVISION }}>
      window.dataLayer = window.dataLayer || [];
      function gtag() { dataLayer.push(arguments); }
      window.gtag = gtag;
      gtag("consent", "default", {
        ad_storage: "denied",
        ad_user_data: "denied",
        ad_personalization: "denied",
        analytics_storage: "denied",
        functionality_storage: "granted",
        security_storage: "granted",
        wait_for_update: 500
      });
      gtag("set", "ads_data_redaction", true);
      try {
        var m = document.cookie.match(new RegExp("(?:^|; )" + consentCookie + "=([^;]*)"));
        var v = m && JSON.parse(decodeURIComponent(m[1]));
        if (v && v.revision === consentRevision && Array.isArray(v.categories)) {
          gtag("consent", "update", {
            analytics_storage: v.categories.indexOf("analytics") > -1 ? "granted" : "denied"
          });
        }
      } catch (e) {}
    </script>
    <!-- Google Tag Manager -->
    <script is:inline define:vars={{ gtmId: GTM_ID }}>
      (function(w,d,s,l,i){w[l]=w[l]||[];w[l].push({'gtm.start':new Date().getTime(),event:'gtm.js'});var f=d.getElementsByTagName(s)[0],j=d.createElement(s),dl=l!='dataLayer'?'&l='+l:'';j.async=true;j.src='https://www.googletagmanager.com/gtm.js?id='+i+dl;f.parentNode.insertBefore(j,f);})(window,document,'script','dataLayer',gtmId);
    </script>
    <!-- End Google Tag Manager -->
    <!-- Umami Cloud: cookieless, anonymous analytics for every visitor. Not tied
         to the cookie banner or Consent Mode (stores nothing on the device).
         data-domains = only count the live site (not localhost / Netlify previews). -->
    <script is:inline defer src="https://cloud.umami.is/script.js" data-website-id="59d445dd-1880-4e05-9726-6311e4cebbd4" data-domains="untitledoffice.gr,www.untitledoffice.gr"></script>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="description" content={description} />
    <title>{title}</title>
    <!-- Neue Haas Grotesk via Adobe Fonts (Typekit) kit. -->
    <link rel="preconnect" href="https://use.typekit.net" crossorigin />
    <link rel="stylesheet" href="https://use.typekit.net/yae3ppr.css" />
    <!-- Theme bootstrap: applies saved choice before paint to avoid a flash.
         Default is light + grayscale (per spec). localStorage is guarded so
         it degrades gracefully where storage is unavailable. -->
    <script is:inline>
      (function () {
        try {
          var m = localStorage.getItem("uo-mode");
          var c = localStorage.getItem("uo-color");
          if (m) document.documentElement.setAttribute("data-mode", m);
          if (c) document.documentElement.setAttribute("data-color", c);
        } catch (e) {}
      })();
    </script>
    <!-- Mark JS-on BEFORE paint so the reveal pre-state (hidden) applies with no
         flash. With no JS this never runs → text stays visible. -->
    <script is:inline>
      document.documentElement.classList.add("js-reveal");
    </script>
  </head>
  <body>
    <!-- Google Tag Manager (noscript) -->
    <noscript><iframe src={`https://www.googletagmanager.com/ns.html?id=${GTM_ID}`} height="0" width="0" style="display:none;visibility:hidden"></iframe></noscript>
    <!-- End Google Tag Manager (noscript) -->
    <CustomCursor />
    <slot />
  </body>
</html>

<script>
  // Cookie banner, loaded on demand: on a first visit (no valid stored choice)
  // or when a [data-cc-settings] control ("Cookie settings") is clicked.
  // Returning visitors with a valid choice never download the banner code.
  import { readStoredConsent, bannerDismissed } from "../scripts/consent-config";
  const loadConsent = () => import("../scripts/consent");
  // no valid choice yet → show the banner, unless it was closed with the X
  // earlier in this session (then it waits for the next visit)
  if (!readStoredConsent() && !bannerDismissed()) loadConsent().then((m) => m.startConsent());
  document.addEventListener("click", (e) => {
    const t = e.target instanceof Element ? e.target.closest("[data-cc-settings]") : null;
    if (!t) return;
    e.preventDefault();
    loadConsent().then(async (m) => { await m.startConsent(); m.showPreferences(); });
  });
</script>

<script>
  // Masked slide-up reveal on first scroll into view (mirrors the burger nav).
  // Staggers siblings within their parent, reveals each element once.
  (function () {
    const els = Array.prototype.slice.call(
      document.querySelectorAll(".reveal-on-scroll")
    );
    if (!els.length) return;

    const reduce = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
    if (reduce || !("IntersectionObserver" in window)) {
      els.forEach((el) => el.classList.add("revealed")); // show statically
      return;
    }

    // cascade: delay by index among reveal-siblings in the same parent
    els.forEach((el) => {
      const parent = el.parentElement;
      if (!parent) return;
      const sibs = Array.prototype.filter.call(parent.children, (c) =>
        c.classList && c.classList.contains("reveal-on-scroll")
      );
      const idx = sibs.indexOf(el);
      if (idx > 0) el.style.setProperty("--reveal-delay", idx * 240 + "ms");
    });

    const io = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            entry.target.classList.add("revealed");
            io.unobserve(entry.target); // animate once
          }
        });
      },
      { threshold: 0.15 }
    );
    els.forEach((el) => io.observe(el));
  })();
</script>
